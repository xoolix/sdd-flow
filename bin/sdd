#!/usr/bin/env bash
set -euo pipefail

# SDD — Spec Driven Development CLI
# Initializes any project with the SDD workflow for Claude Code.

SDD_HOME="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/.." && pwd)"
VERSION="2.1.0"

# ─── Core SDD skills (these go to global ~/.claude/skills/) ──────
CORE_SKILLS="new-feature new-quick-feature new-fix plan-feature implement-task simplify-code review-feature archive-feature research-spike sdd-new sdd-next sdd-auto sdd-hitl init-project build-registry feature-spec diagnose-bug tdd grill-me prototype work-unit-commits comment-writer branch-pr chained-pr _shared"

# ─── helpers ───────────────────────────────────────────────────────

log()  { printf "\033[0;34m▸\033[0m %s\n" "$*"; }
ok()   { printf "\033[0;32m✔\033[0m %s\n" "$*"; }
warn() { printf "\033[0;33m⚠\033[0m %s\n" "$*"; }
err()  { printf "\033[0;31m✖\033[0m %s\n" "$*" >&2; }

is_core_skill() {
  local name="$1"
  for core in $CORE_SKILLS; do
    [ "$name" = "$core" ] && return 0
  done
  return 1
}

link_or_copy() {
  local src="$1" dst="$2" mode="${3:-link}"
  mkdir -p "$(dirname "$dst")"
  if [ "$mode" = "copy" ]; then
    cp -R "$src" "$dst"
  else
    ln -sfn "$src" "$dst"
  fi
}

# True if the project at $1 (default pwd) was installed in --copy mode.
# Primary signal: `.specify/.sdd-copy-install` sentinel file, written by `sdd init --copy`.
# Legacy fallback: `.specify/templates` is a regular dir that resolves to a path OUTSIDE SDD_HOME
# (real-path check — `cp -R` on a symlink source may produce either symlink or copy depending
# on platform; the sentinel makes intent explicit).
is_copy_install() {
  local target="${1:-$(pwd)}"
  [ -f "$target/.specify/.sdd-copy-install" ] && return 0
  # Legacy fallback for projects that predate the sentinel
  [ -d "$target/.specify/templates" ] && [ ! -L "$target/.specify/templates" ] || return 1
  # Confirm via real-path: if readlink resolves templates into SDD_HOME, it's a symlink install
  local real_tpl
  real_tpl="$(cd "$target/.specify/templates" 2>/dev/null && pwd -P)" || return 1
  case "$real_tpl" in
    "$SDD_HOME"/*) return 1 ;;
    *) return 0 ;;
  esac
}

# Ensure a path is present in the project's .gitignore. No-op if already listed.
# Creates .gitignore if missing. Matches whole-line entries.
ensure_gitignored() {
  local target="$1" path="$2"
  local gi="$target/.gitignore"
  [ -f "$gi" ] || touch "$gi"
  if ! grep -Fxq "$path" "$gi" 2>/dev/null; then
    printf '%s\n' "$path" >> "$gi"
    ok "Added $path to .gitignore"
  fi
}

# Gitignore the two machine-local CLAUDE.md artifacts (symlink + its migration backup).
# Called ONLY from symlink-mode branches — --copy installs commit CLAUDE.md to git.
gitignore_claude_md_artifacts() {
  local target="$1"
  ensure_gitignored "$target" ".claude/CLAUDE.md"
  ensure_gitignored "$target" ".claude/CLAUDE.md.backup"
}

usage() {
  cat <<EOF
sdd — Spec Driven Development CLI (v${VERSION})

Usage:
  sdd init [--copy]              Initialize SDD in the current directory
  sdd init --global              Install core SDD skills to ~/.claude/skills/ (one time)
  sdd update                     Re-sync symlinks (skills, templates, memory,
                                 CLAUDE.md, agents); migrate pre-symlink CLAUDE.md to
                                 symlink with backup; prune orphaned agents + global
                                 skills; remove legacy skills/shared symlink
  sdd doctor                     Verify SDD setup is healthy
  sdd base-branch [feature-id]   Resolve the base branch for scope computations
                                 (Layer 1: sidecar, Layer 2: git.md config, Layer 3: auto-detect)
  sdd branch <feature-id>        Idempotently switch to feature/<feature-id> (create if missing)
  sdd commit-slice <feature-id>  Stage --files plus the derived specs/<feature-id> dir and commit;
                                 never pushes, never 'git add -A'
                                 (--type <t> [--task Tnnn] [--moved-from <path>] --title "<s>"
                                 --files <p>... ; --files last)
                                 --moved-from stages the deletion of a path guarded by
                                 'git ls-files --error-unmatch'; never-tracked ⇒ exit 3, named
                                 requires the current branch to be feature/<feature-id> ⇒ exit 4
                                 otherwise, no commit
  sdd status [feature-id]        Emit JSON describing a feature's SDD phase and state
  sdd state-write <feature-id>   Write specs/<feature-id>/.sdd-state: phase
                                 (ready-to-review|reviewed), git-head, tree-digest
                                 (scratch-index snapshot of the full working tree;
                                 never touches the real index or worktree), verdict
                                 (PASS|PASS-WITH-WARNINGS|FAIL|none, default none),
                                 and an ISO-8601 timestamp
                                 (--phase <p> [--verdict <v>])
  sdd domain-vocab               Print .claude/rules/domains.md;
                                 exit 3 (no output) if empty, comment-only, or absent
  sdd verify-archive <feature-id> Verify HEAD actually moved both halves of the
                                 archive: >=1 deletion under specs/<feature-id>/,
                                 >=1 addition under specs/archive/*-<feature-id>/,
                                 and specs/<feature-id>/ gone from HEAD's tree
                                 (exit 0); exit 1 names the missing half; exit 3
                                 when no archive dir exists for the id, or when
                                 HEAD adds nothing under it (nothing to verify);
                                 two archive dirs for the same id resolve to the
                                 most recent, noted on stderr
  sdd help                       Show this help

Options for 'init':
  --copy     Copy files instead of symlinking (standalone, no auto-updates)
  --global   Install core SDD skills globally to ~/.claude/skills/

Layers:
  ~/.claude/skills/        Core SDD skills (shared across all projects)
  .claude/skills/          Project-specific skills (React, Go, etc.)
  .claude/rules/           Project conventions + model overrides
  .claude/CLAUDE.md        Symlink to SDD_HOME (auto-updates on SDD git pull)

After 'sdd init', start Claude Code and run /init-project to auto-generate
architecture docs and detect project conventions.
EOF
}

# ─── init --global ────────────────────────────────────────────────

cmd_init_global() {
  local mode="${1:-link}"

  log "Installing core SDD skills to ~/.claude/skills/ (mode: $mode)"

  mkdir -p "$HOME/.claude/skills"

  # Install core skills
  for skill in $CORE_SKILLS; do
    local src="$SDD_HOME/.claude/skills/$skill"
    if [ -d "$src" ] || [ -f "$src" ]; then
      link_or_copy "$src" "$HOME/.claude/skills/$skill" "$mode"
      ok "Core skill: $skill"
    else
      warn "Core skill not found in repo: $skill"
    fi
  done

  # Install templates globally
  mkdir -p "$HOME/.specify"
  link_or_copy "$SDD_HOME/.specify/templates" "$HOME/.specify/templates" "$mode"
  ok "Templates installed to ~/.specify/templates/"

  echo ""
  ok "Global SDD core installed!"
  echo ""
  log "Now run 'sdd init' inside each project to set up project-specific files."
}

# ─── init (project) ──────────────────────────────────────────────

cmd_init() {
  local mode="link"
  local global=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --copy) mode="copy"; shift ;;
      --global) global=true; shift ;;
      *) err "Unknown option: $1"; exit 1 ;;
    esac
  done

  if $global; then
    cmd_init_global "$mode"
    return
  fi

  local target
  target="$(pwd)"

  if [ "$target" = "$SDD_HOME" ]; then
    err "Cannot init inside the SDD boilerplate repo itself."
    exit 1
  fi

  # Check if global core is installed
  if [ ! -d "$HOME/.claude/skills/sdd-next" ] && [ ! -L "$HOME/.claude/skills/sdd-next" ]; then
    warn "Core SDD skills not found in ~/.claude/skills/"
    log "Installing globally first..."
    cmd_init_global "$mode"
    echo ""
  fi

  log "Initializing SDD project in $target"

  # ── Project-specific skills directory ──
  mkdir -p "$target/.claude/skills"

  # Install architecture-map (project-specific — each repo has its own)
  local arch_src="$SDD_HOME/.claude/skills/architecture-map"
  if [ -d "$arch_src" ]; then
    if [ ! -d "$target/.claude/skills/architecture-map" ] && [ ! -L "$target/.claude/skills/architecture-map" ]; then
      cp -R "$arch_src" "$target/.claude/skills/architecture-map"
      ok "Created .claude/skills/architecture-map/ (project-specific)"
    else
      warn "Skipped architecture-map (already exists)"
    fi
  fi

  # ── Templates (symlink to global if available, else from SDD_HOME) ──
  mkdir -p "$target/.specify"
  if [ -d "$HOME/.specify/templates" ] || [ -L "$HOME/.specify/templates" ]; then
    link_or_copy "$HOME/.specify/templates" "$target/.specify/templates" "$mode"
  else
    link_or_copy "$SDD_HOME/.specify/templates" "$target/.specify/templates" "$mode"
  fi
  ok "Templates installed"

  # Mark --copy installs with an explicit sentinel so is_copy_install() is reliable
  # regardless of what cp -R produces on a symlinked source.
  if [ "$mode" = "copy" ]; then
    : > "$target/.specify/.sdd-copy-install"
  fi

  # ── Scripts (shared) ──
  if [ -d "$SDD_HOME/.specify/scripts" ]; then
    link_or_copy "$SDD_HOME/.specify/scripts" "$target/.specify/scripts" "$mode"
    ok "Scripts installed"
  fi

  # ── Memory (constitution.md + future shared memory) ──
  if [ -d "$SDD_HOME/.specify/memory" ]; then
    if [ -e "$target/.specify/memory" ] || [ -L "$target/.specify/memory" ]; then
      warn "Skipped .specify/memory/ (already exists)"
    else
      link_or_copy "$SDD_HOME/.specify/memory" "$target/.specify/memory" "$mode"
      ok "Memory installed (constitution.md)"
    fi
  fi

  # ── Rules (project-specific — always copy, never overwrite existing) ──
  # Sourced from a pristine, versioned seed (.specify/templates/rules/), NOT from
  # SDD_HOME's own .claude/rules/*.md. SDD_HOME describes itself in the latter
  # (its own Domain rules, its own model-override rows) — copying those verbatim
  # would leak this repo's description into every new project. See decisions.md
  # SEED-CONTAMINATION (feature 021, T009).
  mkdir -p "$target/.claude/rules"
  local rules_seed="$SDD_HOME/.specify/templates/rules"
  for rule_file in "$rules_seed"/*.md; do
    [ -f "$rule_file" ] || continue
    local rule_name
    rule_name="$(basename "$rule_file")"
    if [ -f "$target/.claude/rules/$rule_name" ]; then
      warn "Skipped .claude/rules/$rule_name (already exists)"
    else
      cp "$rule_file" "$target/.claude/rules/$rule_name"
      ok "Created .claude/rules/$rule_name"
    fi
  done

  # ── Agents (project-local copies, never overwrite) ──
  # Native sub-agents are discovered by Claude Code at session init from .claude/agents/*.md.
  # They declare model/tools/context in frontmatter. Skill routers in .claude/skills/*/SKILL.md
  # delegate to them via Agent tool (subagent_type: "sdd-<phase>"). See feature 008.
  if [ -d "$SDD_HOME/.claude/agents" ]; then
    mkdir -p "$target/.claude/agents"
    for agent_file in "$SDD_HOME/.claude/agents"/sdd-*.md; do
      [ -f "$agent_file" ] || continue
      local agent_name
      agent_name="$(basename "$agent_file")"
      if [ -f "$target/.claude/agents/$agent_name" ]; then
        warn "Skipped .claude/agents/$agent_name (already exists)"
      else
        cp "$agent_file" "$target/.claude/agents/$agent_name"
        ok "Created .claude/agents/$agent_name"
      fi
    done
  fi

  # ── CLAUDE.md (symlink by default for auto-updates, cp on --copy) ──
  # -e tests if the target exists (follows symlinks). A broken symlink → -e false, -L true.
  # We repair broken symlinks rather than silently skipping them.
  if [ -e "$target/.claude/CLAUDE.md" ]; then
    warn "Skipped .claude/CLAUDE.md (already exists)"
  else
    if [ -L "$target/.claude/CLAUDE.md" ]; then
      rm "$target/.claude/CLAUDE.md"
      log "Removed broken CLAUDE.md symlink"
    fi
    link_or_copy "$SDD_HOME/.claude/CLAUDE.md" "$target/.claude/CLAUDE.md" "$mode"
    if [ "$mode" = "copy" ]; then
      ok "Created .claude/CLAUDE.md (copy — standalone, no auto-updates)"
    else
      ok "Created .claude/CLAUDE.md (symlink → SDD_HOME, auto-updates on git pull)"
      gitignore_claude_md_artifacts "$target"
    fi
  fi

  # ── settings.local.json (never overwrite) ──
  if [ -f "$target/.claude/settings.local.json" ]; then
    warn "Skipped .claude/settings.local.json (already exists)"
  else
    if [ -f "$SDD_HOME/.claude/settings.local.json" ]; then
      cp "$SDD_HOME/.claude/settings.local.json" "$target/.claude/settings.local.json"
      ok "Created .claude/settings.local.json"
    fi
  fi

  # ── Directory structure ──
  mkdir -p "$target/specs" "$target/research" "$target/docs/adr" "$target/docs/architecture"
  ok "Created specs/, research/, docs/adr/, docs/architecture/"

  echo ""
  ok "SDD project initialized!"
  echo ""
  log "Structure:"
  echo "  ~/.claude/skills/         ← Core SDD skills (global, shared)"
  echo "  .claude/skills/           ← Project skills (add React, Go, etc. here)"
  echo "  .claude/rules/            ← Project conventions"
  echo "  .claude/CLAUDE.md         ← Orchestrator config"
  echo ""
  log "Next steps:"
  echo "  1. Open Claude Code in $target"
  echo "  2. Run /init-project to auto-detect architecture and conventions"
  echo "  3. Add project skills to .claude/skills/ (React, Python, etc.)"
  echo "  4. Run /build-registry to generate compact rules from your skills"
  echo "  5. Start working: /sdd-new \"your idea\""
  echo ""
}

# ─── update ────────────────────────────────────────────────────────

cmd_update() {
  local target
  target="$(pwd)"

  # Protection: refuse to update inside the SDD boilerplate repo itself.
  # Running `sdd update` with target == SDD_HOME creates self-referential (circular)
  # symlinks for CLAUDE.md. Observed in feature 008 dev cycle — caused ELOOP.
  if [ "$target" = "$SDD_HOME" ]; then
    err "Cannot update inside the SDD boilerplate repo itself."
    exit 1
  fi

  log "Updating SDD"

  # Ensure base project folders exist. These are non-destructive and are required by
  # `sdd doctor`; older projects may predate research/ or docs/architecture/.
  mkdir -p "$target/specs" "$target/research" "$target/docs/adr" "$target/docs/architecture"
  ok "Ensured specs/, research/, docs/adr/, docs/architecture/"

  # Update global core skills
  log "Updating global core skills..."
  for skill in $CORE_SKILLS; do
    local global_skill="$HOME/.claude/skills/$skill"
    if [ -L "$global_skill" ]; then
      ln -sfn "$SDD_HOME/.claude/skills/$skill" "$global_skill"
      ok "Updated global: $skill"
    elif [ -d "$global_skill" ]; then
      warn "Skipped global $skill (not a symlink — was copied with --copy)"
    else
      ln -sfn "$SDD_HOME/.claude/skills/$skill" "$global_skill"
      ok "Added global: $skill"
    fi
  done

  # ── Prune orphan global skills (broken symlinks pointing into SDD_HOME) ──
  # Catches skills renamed/removed upstream (e.g., sdd-continue → sdd-next migration).
  # Only touches symlinks pointing INTO $SDD_HOME — leaves user-installed skills
  # like langfuse, find-skills, etc. alone even if broken (not our responsibility).
  if [ -d "$HOME/.claude/skills" ]; then
    local global_pruned=0
    for global_skill in "$HOME/.claude/skills"/*; do
      [ -L "$global_skill" ] || continue
      local skill_name link_target
      skill_name="$(basename "$global_skill")"
      link_target="$(readlink "$global_skill")"
      case "$link_target" in
        "$SDD_HOME"/*)
          if [ ! -e "$global_skill" ]; then
            rm "$global_skill"
            ok "Pruned global orphan: $skill_name"
            : $((global_pruned++))
          fi
          ;;
      esac
    done
  fi

  # Update project templates
  if [ -d "$target/.specify" ]; then
    if [ -L "$target/.specify/templates" ]; then
      if [ -d "$HOME/.specify/templates" ] || [ -L "$HOME/.specify/templates" ]; then
        ln -sfn "$HOME/.specify/templates" "$target/.specify/templates"
      else
        ln -sfn "$SDD_HOME/.specify/templates" "$target/.specify/templates"
      fi
      ok "Updated templates"
    else
      warn "Skipped templates (not a symlink)"
    fi
  fi

  # ── Memory: refresh symlink (constitution + future shared memory) ──
  if [ -d "$SDD_HOME/.specify/memory" ]; then
    if [ -L "$target/.specify/memory" ]; then
      ln -sfn "$SDD_HOME/.specify/memory" "$target/.specify/memory"
      ok "Updated memory (constitution)"
    elif [ ! -e "$target/.specify/memory" ]; then
      mkdir -p "$target/.specify"
      ln -sfn "$SDD_HOME/.specify/memory" "$target/.specify/memory"
      ok "Created memory symlink (was absent)"
    else
      warn "Skipped memory (not a symlink — likely --copy install or local override)"
    fi
  fi

  # ── Legacy cleanup: skills/shared was previously linked at the project root.
  # Now feature-spec and diagnose-bug live under .claude/skills/ (global CORE_SKILLS).
  # Remove the legacy symlink if it points into SDD_HOME, and remove skills/ if empty.
  if [ -L "$target/skills/shared" ]; then
    local legacy_target
    legacy_target="$(readlink "$target/skills/shared")"
    case "$legacy_target" in
      "$SDD_HOME"/*)
        rm "$target/skills/shared"
        ok "Removed legacy skills/shared symlink (now lives under .claude/skills/)"
        ;;
    esac
  fi
  if [ -d "$target/skills" ] && [ ! -L "$target/skills" ] && [ -z "$(ls -A "$target/skills" 2>/dev/null)" ]; then
    rmdir "$target/skills"
    ok "Removed empty skills/ directory"
  fi

  # ── CLAUDE.md: refresh symlink or migrate pre-symlink copy ──
  # Respect --copy installs: don't force-migrate when the project opted out.
  local claude_md="$target/.claude/CLAUDE.md"
  if is_copy_install "$target"; then
    if [ -f "$claude_md" ] && [ ! -L "$claude_md" ]; then
      warn "Skipped CLAUDE.md migration (--copy install detected)"
    elif [ -L "$claude_md" ] && [ ! -e "$claude_md" ]; then
      # --copy install with a broken symlink (unusual state — user likely replaced manually)
      rm "$claude_md"
      cp "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
      ok "Repaired broken CLAUDE.md (copy — standalone install)"
    elif [ ! -e "$claude_md" ] && [ ! -L "$claude_md" ]; then
      # --copy install but CLAUDE.md is absent — restore as copy (NOT symlink; respects --copy)
      cp "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
      ok "Restored missing CLAUDE.md (copy — standalone install)"
    fi
    # --copy: do NOT auto-gitignore (users of this mode legitimately track CLAUDE.md in git)
  elif [ -L "$claude_md" ] && [ -e "$claude_md" ]; then
    ln -sfn "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
    ok "Refreshed CLAUDE.md symlink"
    gitignore_claude_md_artifacts "$target"
  elif [ -L "$claude_md" ]; then
    # Broken OR circular symlink — repair by replacing target.
    # Circular case: readlink returns a path that resolves back to $claude_md (ELOOP).
    # Both cases: [ -L true ] && [ -e false ]. Same fix for both.
    rm "$claude_md"
    ln -sfn "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
    ok "Repaired broken/circular CLAUDE.md symlink"
    gitignore_claude_md_artifacts "$target"
  elif [ -f "$claude_md" ]; then
    log "Migrating .claude/CLAUDE.md from copy to symlink..."
    if [ -e "$claude_md.backup" ]; then
      warn "Skipped backup (.claude/CLAUDE.md.backup already exists) — existing backup preserved"
    else
      cp "$claude_md" "$claude_md.backup"
    fi
    rm "$claude_md"
    ln -sfn "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
    ok "Migrated CLAUDE.md → symlink (backup at .claude/CLAUDE.md.backup)"
    warn "Review backup for custom overrides; move them to .claude/rules/model-overrides.md"
    gitignore_claude_md_artifacts "$target"
  else
    # No CLAUDE.md present — create symlink (honors spec §Happy Path: "si falta, crear")
    ln -sfn "$SDD_HOME/.claude/CLAUDE.md" "$claude_md"
    ok "Created CLAUDE.md symlink (was absent)"
    gitignore_claude_md_artifacts "$target"
  fi

  # ── Agents: sync upstream sdd-*.md files; byte-diff decides action ──
  # (a) absent → copy in; (b) identical → skip; (c) changed → overwrite.
  # Only upstream files are iterated — project-local agents are never touched.
  if [ -d "$SDD_HOME/.claude/agents" ]; then
    mkdir -p "$target/.claude/agents"
    local added=0 updated=0 unchanged=0
    for agent_file in "$SDD_HOME/.claude/agents"/sdd-*.md; do
      [ -f "$agent_file" ] || continue
      local agent_name
      agent_name="$(basename "$agent_file")"
      local agent_dst="$target/.claude/agents/$agent_name"
      if [ ! -e "$agent_dst" ]; then
        cp "$agent_file" "$agent_dst"
        ok "Added .claude/agents/$agent_name"
        : $((added++))
      elif cmp -s "$agent_file" "$agent_dst"; then
        : $((unchanged++))
      else
        cp "$agent_file" "$agent_dst"
        ok "Updated: $agent_name"
        : $((updated++))
      fi
    done
    # ── Prune pass: remove project-side sdd-*.md files absent from upstream ──
    local pruned=0
    for project_agent in "$target/.claude/agents"/sdd-*.md; do
      [ -f "$project_agent" ] || continue
      local agent_name
      agent_name="$(basename "$project_agent")"
      if [ ! -f "$SDD_HOME/.claude/agents/$agent_name" ]; then
        rm "$project_agent"
        ok "Pruned: $agent_name"
        : $((pruned++))
      fi
    done
    log "Agents: $added added, $updated updated, $unchanged unchanged, $pruned pruned"
  fi

  ok "Update complete!"
}

# ─── doctor ────────────────────────────────────────────────────────

cmd_doctor() {
  local target
  target="$(pwd)"
  local issues=0

  log "Checking SDD setup"

  # Check global core skills
  echo ""
  log "Global core (~/.claude/skills/):"
  for skill in $CORE_SKILLS; do
    if [ -d "$HOME/.claude/skills/$skill" ] || [ -L "$HOME/.claude/skills/$skill" ]; then
      ok "  $skill"
    else
      warn "  $skill — MISSING (run 'sdd init --global')"
      ((issues++))
    fi
  done

  # Check project structure
  echo ""
  log "Project ($target):"
  for dir in .claude .claude/skills .claude/rules .specify .specify/memory specs research docs; do
    if [ -d "$target/$dir" ]; then
      ok "  $dir/"
    else
      warn "  $dir/ — MISSING (run 'sdd update' to install)"
      ((issues++))
    fi
  done

  # Check key project files
  for file in .claude/rules/conventions.md .specify/memory/constitution.md; do
    if [ -f "$target/$file" ]; then
      ok "  $file"
    else
      warn "  $file — MISSING"
      ((issues++))
    fi
  done

  # CLAUDE.md should be a symlink (auto-updates) unless --copy install
  local claude_md="$target/.claude/CLAUDE.md"
  if [ "$target" = "$SDD_HOME" ] && [ -f "$claude_md" ] && [ ! -L "$claude_md" ]; then
    ok "  .claude/CLAUDE.md (source file in SDD_HOME)"
  elif [ -L "$claude_md" ] && [ -e "$claude_md" ]; then
    ok "  .claude/CLAUDE.md (symlink → auto-updates)"
  elif [ -L "$claude_md" ]; then
    warn "  .claude/CLAUDE.md is a broken symlink (target missing) — run 'sdd update' to repair"
    ((issues++))
  elif [ -f "$claude_md" ]; then
    if is_copy_install "$target"; then
      ok "  .claude/CLAUDE.md (copy — --copy install)"
    else
      warn "  .claude/CLAUDE.md is a regular file — run 'sdd update' to migrate to symlink"
      ((issues++))
    fi
  else
    warn "  .claude/CLAUDE.md — MISSING (run 'sdd update' to create symlink)"
    ((issues++))
  fi

  # Warn if CLAUDE.md is git-tracked (absolute symlinks don't port across team machines)
  if [ "$target" != "$SDD_HOME" ] && [ -e "$claude_md" ] && (cd "$target" && git ls-files --error-unmatch .claude/CLAUDE.md &>/dev/null); then
    if [ -f "$target/.gitignore" ] && grep -Fxq ".claude/CLAUDE.md" "$target/.gitignore"; then
      warn "  .claude/CLAUDE.md is in .gitignore but still tracked — run: git rm --cached .claude/CLAUDE.md && git commit"
    else
      warn "  .claude/CLAUDE.md is tracked in git — add to .gitignore AND run: git rm --cached .claude/CLAUDE.md && git commit"
    fi
    ((issues++))
  fi

  # Check for orphaned sdd-*.md agent files (present in project but absent upstream)
  if [ -d "$target/.claude/agents" ]; then
    for project_agent in "$target/.claude/agents"/sdd-*.md; do
      [ -f "$project_agent" ] || continue
      local agent_name
      agent_name="$(basename "$project_agent")"
      if [ ! -f "$SDD_HOME/.claude/agents/$agent_name" ]; then
        warn "  .claude/agents/$agent_name — orphan (not in upstream). Run 'sdd update' to remove."
        ((issues++))
      fi
    done
  fi

  # Check architecture-map
  local arch_file="$target/.claude/skills/architecture-map/SKILL.md"
  if [ -f "$arch_file" ]; then
    if grep -q "TODO" "$arch_file" 2>/dev/null; then
      warn "  architecture-map has TODOs — run /init-project"
      ((issues++))
    else
      ok "  architecture-map (populated)"
    fi
  else
    warn "  architecture-map — MISSING"
    ((issues++))
  fi

  # Check project-specific skills
  echo ""
  log "Project skills (.claude/skills/):"
  local project_skills=0
  for skill_dir in "$target/.claude/skills"/*/; do
    [ ! -d "$skill_dir" ] && continue
    local skill_name
    skill_name="$(basename "$skill_dir")"
    # Skip core skills and architecture-map
    if is_core_skill "$skill_name" || [ "$skill_name" = "architecture-map" ]; then
      continue
    fi
    local skill_file="$skill_dir/SKILL.md"
    if [ -f "$skill_file" ]; then
      # Check for applies-to frontmatter
      if grep -q "applies-to:" "$skill_file" 2>/dev/null; then
        local applies_to
        applies_to=$(grep "applies-to:" "$skill_file" | head -1 | sed 's/.*applies-to: *//')
        ok "  $skill_name → $applies_to"
      else
        log "  $skill_name → implement-task, review-feature (default)"
      fi
      ((project_skills++))
    fi
  done
  if [ "$project_skills" -eq 0 ]; then
    log "  (none — add project skills to .claude/skills/)"
  fi

  # Check skill registry
  echo ""
  log "Skill registry:"
  local registry_file="$target/.claude/skills/skill-registry.md"
  if [ -f "$registry_file" ]; then
    local registry_skills
    registry_skills=$(grep -c "^### " "$registry_file" 2>/dev/null || echo "0")
    ok "  skill-registry.md ($registry_skills compact rule sets)"
    if [ "$project_skills" -gt 0 ] && [ "$registry_skills" -lt "$project_skills" ]; then
      warn "  Registry has fewer skills than installed — run /build-registry"
      ((issues++))
    fi
  else
    if [ "$project_skills" -gt 0 ]; then
      warn "  skill-registry.md — MISSING (run /build-registry to generate)"
      ((issues++))
    else
      log "  (no project skills installed, registry not needed)"
    fi
  fi

  # Check Engram
  echo ""
  log "Engram:"
  if command -v engram &>/dev/null; then
    ok "  engram binary: $(engram version 2>/dev/null || echo 'installed')"
    if [ -f "$HOME/.engram/engram.db" ]; then
      ok "  database: ~/.engram/engram.db"
    else
      warn "  database not found — run 'engram setup claude-code'"
      ((issues++))
    fi
  else
    warn "  engram not installed — run 'brew install gentleman-programming/tap/engram'"
    ((issues++))
  fi

  echo ""
  if [ "$issues" -eq 0 ]; then
    ok "All checks passed!"
  else
    warn "$issues issue(s) found"
  fi
}

# ─── base-branch ───────────────────────────────────────────────────

cmd_base_branch() {
  local feature_id="${1:-}"

  # ── Layer 1: per-feature sidecar, active dir or archived (F1) ──
  if [ -n "$feature_id" ]; then
    local specs_dir feature_dir
    specs_dir="$(pwd)/specs"
    if feature_dir="$(resolve_feature_dir "$feature_id" "$specs_dir")"; then
      local sidecar="$feature_dir/.parent-branch"
      if [ -f "$sidecar" ]; then
        # Read first line only; strip leading/trailing whitespace
        local ref
        ref="$(head -n1 "$sidecar" | tr -d '[:space:]')"
        if [ -n "$ref" ]; then
          # Non-empty after trim — must resolve
          if git rev-parse --verify "$ref" >/dev/null 2>&1; then
            printf '%s\n' "$ref"
            return 0
          else
            printf 'error: %s references missing branch "%s"\n' "$sidecar" "$ref" >&2
            return 2
          fi
        fi
        # Empty/whitespace sidecar — fall through to Layer 2
      fi
    fi
    # Unresolvable feature-id (no active or archived dir) — fall through to Layer 2, never abort.
  fi

  # ── Layer 2: project config in .claude/rules/git.md ──────────────
  local git_md=".claude/rules/git.md"
  if [ -f "$git_md" ]; then
    local config_ref
    config_ref="$(grep -m1 '^base-branch:[[:space:]]*' "$git_md" 2>/dev/null | sed 's/^base-branch:[[:space:]]*//' | tr -d '[:space:]' || true)"
    if [ -n "$config_ref" ]; then
      if git rev-parse --verify "$config_ref" >/dev/null 2>&1; then
        printf '%s\n' "$config_ref"
        return 0
      else
        printf 'error: git.md base-branch "%s" does not exist locally\n' "$config_ref" >&2
        return 2
      fi
    fi
  fi

  # ── Layer 3: auto-detect (develop → main → master, smallest count wins) ──
  local best_ref=""
  local best_count=""
  for candidate in develop main master; do
    if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
      local count
      count="$(git rev-list --count "${candidate}..HEAD" 2>/dev/null || true)"
      if [ -z "$best_ref" ] || [ "$count" -lt "$best_count" ]; then
        best_ref="$candidate"
        best_count="$count"
      fi
    fi
  done

  if [ -n "$best_ref" ]; then
    printf '%s\n' "$best_ref"
    return 0
  fi

  printf 'error: no base branch resolvable — set "base-branch:" in .claude/rules/git.md or create specs/<feature-id>/.parent-branch\n' >&2
  return 3
}

# ─── branch ────────────────────────────────────────────────────────

cmd_branch() {
  local feature_id="${1:-}"

  if [ -z "$feature_id" ]; then
    printf 'error: usage: sdd branch <feature-id>\n' >&2
    return 2
  fi

  local branch_name="feature/${feature_id}"
  local current_branch
  current_branch="$(git branch --show-current 2>/dev/null || true)"

  if [ "$current_branch" = "$branch_name" ]; then
    printf '%s\n' "$branch_name"
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
    if ! git checkout "$branch_name"; then
      return 4
    fi
  else
    if ! git checkout -b "$branch_name"; then
      return 4
    fi
  fi

  # AC3 -- two independent behaviours (plan.md): (a) always record the
  # resolved parent so cmd_base_branch Layer 1 has something correct to
  # read later, (b) warn -- never refuse -- when that parent is itself
  # another feature/* branch (silent stacking is V3). $current_branch is
  # the branch we were on BEFORE the checkout above, i.e. the true parent;
  # reading it now would just read back $branch_name.
  case "$current_branch" in
    feature/*)
      printf 'warning: %s branches off %s, another feature branch -- this is not blocked, only reported; specs/%s/.parent-branch will record %s as the base\n' \
        "$branch_name" "$current_branch" "$feature_id" "$current_branch" >&2
      ;;
  esac

  local specs_dir sidecar
  specs_dir="$(pwd)/specs"
  sidecar="$specs_dir/${feature_id}/.parent-branch"

  # Never clobber an existing sidecar: switching back to an already-branched
  # feature must not rewrite its parent as "whatever branch we happened to
  # be on just now".
  if [ ! -f "$sidecar" ]; then
    if [ -n "$current_branch" ]; then
      mkdir -p "$specs_dir/${feature_id}"
      printf '%s\n' "$current_branch" > "$sidecar"
    else
      # No branch to record (e.g. detached HEAD) -- an empty/whitespace
      # sidecar would make Layer 1 fall through silently, so write nothing
      # rather than something useless.
      printf 'warning: could not resolve a base branch for %s (no current branch, e.g. detached HEAD) -- specs/%s/.parent-branch was not written\n' \
        "$branch_name" "$feature_id" >&2
    fi
  fi

  printf '%s\n' "$branch_name"
  return 0
}

# ─── commit-slice ──────────────────────────────────────────────────

# Reject a feature-id that could make "$specs_dir/$feature_id" resolve
# outside specs/ (".." -- "specs/.." is the repo root -- or a "/" anywhere,
# which nests or escapes the same way), or that would be misread as a flag
# by anything it gets forwarded to (a leading "-"), or that is simply empty.
# Prints nothing and returns 0 when the id is safe to interpolate, 1
# otherwise -- callers decide their own error text and exit code.
validate_feature_id() {
  local feature_id="$1"

  [ -n "$feature_id" ] || return 1

  case "$feature_id" in
    *..*|*/*|-*)
      return 1
      ;;
  esac

  return 0
}

# Resolve a feature's directory: specs/<feature-id> if present, else the
# archived specs/archive/*-<feature-id> match. Prints the resolved absolute
# path on stdout and returns 0 on success; returns 1 with no output otherwise
# (including a malformed id -- see validate_feature_id, checked first).
# Shared by cmd_base_branch, cmd_commit_slice, and cmd_status (F2) so all
# three stay in sync -- validating here, once, is what covers cmd_base_branch
# and cmd_status, neither of which has a validation step of its own.
# Must be called as an `if`/`while` condition (the guarded idiom used by all
# three call sites), never a bare assignment -- under `set -euo pipefail` a
# bare `feature_dir="$(resolve_feature_dir ...)"` on a miss aborts the script
# silently, with no error text naming what failed.
resolve_feature_dir() {
  local feature_id="$1" specs_dir="$2"

  validate_feature_id "$feature_id" || return 1

  if [ -d "$specs_dir/$feature_id" ]; then
    printf '%s\n' "$specs_dir/$feature_id"
    return 0
  fi

  local archive_match
  archive_match="$(find "$specs_dir/archive" -maxdepth 1 -type d -name "*-${feature_id}" 2>/dev/null | head -1)"
  if [ -n "$archive_match" ]; then
    printf '%s\n' "$archive_match"
    return 0
  fi

  return 1
}

cmd_commit_slice() {
  local usage_msg='usage: sdd commit-slice <feature-id> --type <t> [--task Tnnn] [--moved-from <path>] --title "<s>" --files <p>... (--files last)'

  local feature_id="${1:-}"
  [ $# -gt 0 ] && shift

  if [ -z "$feature_id" ]; then
    printf 'error: %s\n' "$usage_msg" >&2
    return 2
  fi

  # AC2: reject a malformed feature-id (path traversal via ".." or "/", or a
  # leading "-") before a single 'git' command runs, let alone touches the
  # index. resolve_feature_dir below also calls validate_feature_id -- that
  # copy is what protects cmd_base_branch and cmd_status, which have no
  # check of their own -- but commit-slice, the write path, needs its own
  # precise exit code (2) rather than the generic "3: feature not found"
  # this same rejection would otherwise fall into further down.
  if ! validate_feature_id "$feature_id"; then
    printf 'error: invalid feature-id: "%s" (must not be empty, contain "..", contain "/", or start with "-")\n' "$feature_id" >&2
    return 2
  fi

  local type="" task="" title="" moved_from=""
  local -a files=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --type)
        [ $# -ge 2 ] || { printf 'error: --type requires a value\n' >&2; return 2; }
        type="$2"
        shift 2
        ;;
      --task)
        [ $# -ge 2 ] || { printf 'error: --task requires a value\n' >&2; return 2; }
        task="$2"
        shift 2
        ;;
      --moved-from)
        [ $# -ge 2 ] || { printf 'error: --moved-from requires a value\n' >&2; return 2; }
        moved_from="$2"
        shift 2
        ;;
      --title)
        [ $# -ge 2 ] || { printf 'error: --title requires a value\n' >&2; return 2; }
        title="$2"
        shift 2
        ;;
      --files)
        shift
        while [ $# -gt 0 ] && [[ "$1" != --* ]]; do
          files+=("$1")
          shift
        done
        ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [ -z "$type" ] || [ -z "$title" ]; then
    printf 'error: %s\n' "$usage_msg" >&2
    return 2
  fi

  # --files may be empty only when --moved-from is present: a move-only
  # commit (e.g. archive with no delta-merge changes) is a legitimate shape
  # -- the moved directory itself carries the staged content, added below
  # unconditionally. Reject the truly-empty invocation (no --files, no
  # --moved-from) right here rather than leaning on the "nothing staged"
  # check further down, so a caller that simply forgot --files still gets
  # the same early, unambiguous usage error it always got.
  if [ "${#files[@]}" -eq 0 ] && [ -z "$moved_from" ]; then
    printf 'error: %s\n' "$usage_msg" >&2
    return 2
  fi

  local specs_dir feature_dir
  specs_dir="$(pwd)/specs"
  if ! feature_dir="$(resolve_feature_dir "$feature_id" "$specs_dir")"; then
    printf 'error: feature not found: %s\n' "$feature_id" >&2
    return 3
  fi

  # AC4/V4: refuse to commit onto the wrong branch. Repro: standing on
  # feature/AAA, `commit-slice BBB --files bbb.txt` committed BBB's work
  # ONTO AAA, exit 0, no complaint. Checked here -- after the feature is
  # confirmed to exist (so "999-missing" still exits 3, not 4) but before
  # anything below touches the index (so, like validate_feature_id above,
  # there is nothing to unwind on failure).
  #
  # The expected name comes from the feature/<feature-id> convention that
  # cmd_branch itself uses -- NOT from .parent-branch, which records the
  # *base* branch for diff scope, a different thing entirely. Only
  # "feature/<feature-id>" is accepted, not "fix/<feature-id>": cmd_branch
  # hard-codes the "feature/" prefix and has never produced anything
  # else, and .claude/rules/git.md's "## Branch naming" section is an
  # unfilled template placeholder (`<!-- e.g. feature/NNN-description,
  # fix/NNN-description -->`), not an adopted convention -- confirmed
  # against this repo's own history, where every branch ever created is
  # "feature/*". Accepting a prefix the tooling can never produce would
  # widen the gate on a guess, not a fact. Anything else that is not this
  # exact name -- another feature/* branch (the repro above), main, a
  # scratch branch, or detached HEAD, where 'git branch --show-current'
  # prints empty -- fails closed the same way.
  local expected_branch="feature/${feature_id}" current_branch
  current_branch="$(git branch --show-current 2>/dev/null || true)"
  if [ "$current_branch" != "$expected_branch" ]; then
    printf 'error: refusing to commit "%s" on branch "%s" (expected "%s") -- run: sdd branch %s\n' \
      "$feature_id" "${current_branch:-<detached HEAD>}" "$expected_branch" "$feature_id" >&2
    return 4
  fi

  # Snapshot every already-staged path BEFORE this invocation's own 'git add'
  # calls touch the index. The undeclared-file check below diffs against
  # this to tell "someone else's legitimately pre-staged work" (e.g. the 13
  # in-flight renames from an unrelated cleanup) apart from a --files
  # omission this invocation is responsible for catching — a file the agent
  # edited but never staged shows up as unstaged both before and after, so
  # it survives this snapshot and still trips the check.
  local pre_staged
  pre_staged="$(git status --porcelain --no-renames 2>/dev/null | awk '{ st = substr($0, 1, 1); if (st != " " && st != "?") print substr($0, 4) }')"

  # feature_dir is absolute (built from "$(pwd)/specs") but git-status paths
  # are repo-root-relative (F8) -- normalize once, up front, so both the AC5
  # warn below and the undeclared-file check further down can prefix-match
  # against it. bin/sdd never 'cd's outside subshells, so stripping
  # "$(pwd)/" is safe.
  local feature_dir_rel="${feature_dir#"$(pwd)/"}"

  # AC5: warn (never change what gets staged) when a file inside this
  # feature's own dir was already staged BEFORE this invocation touched the
  # index -- a HITL decision staged on purpose, or a stray edit riding along
  # by accident. There is no reliable way to tell those two apart, and
  # getting it wrong would *discard* work rather than merely mix it, so this
  # only warns; the feature dir keeps getting swept into the commit exactly
  # as before. Opposite polarity from the undeclared-file check below (that
  # one is an EXCLUSION set over the whole index, checked before the commit;
  # this is an INCLUSION set scoped to the feature dir, checked before it
  # too) -- kept as two separate checks sharing only the one snapshot, not
  # merged.
  if [ -n "$pre_staged" ]; then
    local staged_path staged_in_feature_dir=""
    while IFS= read -r staged_path; do
      case "$staged_path" in
        "$feature_dir_rel"/*)
          staged_in_feature_dir="${staged_in_feature_dir:+${staged_in_feature_dir}$'\n'}${staged_path}"
          ;;
      esac
    done <<< "$pre_staged"
    if [ -n "$staged_in_feature_dir" ]; then
      printf 'warning: feature dir file(s) already staged before commit-slice ran:\n%s\n' "$staged_in_feature_dir" >&2
    fi
  fi

  # Stage exactly the named files plus the derived feature dir. Never 'git add -A'.
  if [ "${#files[@]}" -gt 0 ]; then
    if ! git add -- "${files[@]}"; then
      return 4
    fi
  fi
  if ! git add -- "$feature_dir"; then
    return 4
  fi

  # --moved-from: stage the deletion of a path the caller moved away from.
  # Guard first: tracked in the INDEX ('git ls-files --error-unmatch') covers
  # the common case and still rejects a never-tracked path — a bare 'git add'
  # would otherwise exit 0 and stage it as a brand new addition when it still
  # exists on disk, the opposite of what was asked, and no exit-code check on
  # 'git add' alone catches it. But the index alone is too strict: 'git mv'
  # (the natural way an agent stages a rename, e.g. during archive) already
  # removes the old path from the index even though it is still tracked in
  # HEAD and its deletion is correctly staged — so also accept a path that
  # resolves in HEAD ('git cat-file -e'), which a never-tracked path never
  # does, staged or not.
  if [ -n "$moved_from" ]; then
    local moved_from_in_index=false
    if git ls-files --error-unmatch -- "$moved_from" >/dev/null 2>&1; then
      moved_from_in_index=true
    elif ! git cat-file -e "HEAD:${moved_from}" 2>/dev/null; then
      printf 'error: --moved-from path was never tracked: %s\n' "$moved_from" >&2
      return 3
    fi
    # Only stage it when it is still sitting in the index (e.g. deleted on
    # disk but not yet added) — when it was only found via the HEAD check,
    # the removal is already staged (a prior 'git mv') and 'git add' on a
    # path absent from both the index and the working tree would fail with
    # "did not match any files" for no reason: there is nothing left to add.
    if $moved_from_in_index; then
      if ! git add -- "$moved_from"; then
        return 4
      fi
    fi
  fi

  # V1: reject undeclared new files BEFORE the commit exists (AC1) -- fixed
  # from the old post-commit warning, which diffed the whole index AFTER
  # 'git commit' had already run, so the only fix available was a
  # 'git reset --soft' unwind. Checking here means there is nothing to
  # unwind: on failure, no commit is ever created.
  # 'dirty' starts as the full 'git status --porcelain' (no '^??' filter --
  # dropping that filter is the actual fix; it used to be exactly what let a
  # brand-new untracked file, the most common shape of a --files omission,
  # survive silently). Two exclusion passes bring it down to what's really
  # unaccounted for:
  #   1. pre_staged (:902, snapshotted before this invocation's own 'git
  #      add'): someone else's legitimately pre-existing staged work, not
  #      this invocation's problem. Same awk NR==FNR set-difference as
  #      before -- fed via process substitution, not 'awk -v', because
  #      default macOS/BSD awk rejects a -v value with embedded newlines,
  #      and pre_staged is exactly that.
  #   2. This invocation's own declared paths: every git-status line is
  #      staged content the moment 'git add' above ran, so without this
  #      pass every clean commit-slice call would trip on its own files.
  #      feature_dir and --moved-from both match by prefix (either can be a
  #      directory: a directory 'git add' stages each file under it as its
  #      own status line, and a directory 'git add' on a --moved-from path
  #      stages each of its deletions the same way); --files entries match
  #      exactly, since they are always concrete file paths.
  local dirty
  dirty="$(git status --porcelain --no-renames 2>/dev/null)"
  if [ -n "$pre_staged" ] && [ -n "$dirty" ]; then
    dirty="$(awk 'NR==FNR { seen[$0]=1; next } { path = substr($0, 4); if (!(path in seen)) print }' \
      <(printf '%s\n' "$pre_staged") <(printf '%s\n' "$dirty"))"
  fi
  if [ -n "$dirty" ]; then
    local dirty_line dirty_path declared_hit declared_file filtered=""
    while IFS= read -r dirty_line; do
      [ -z "$dirty_line" ] && continue
      dirty_path="${dirty_line:3}"
      case "$dirty_path" in
        "$feature_dir_rel"/*)
          continue
          ;;
      esac
      if [ -n "$moved_from" ]; then
        case "$dirty_path" in
          "$moved_from"|"$moved_from"/*)
            continue
            ;;
        esac
      fi
      declared_hit=false
      if [ "${#files[@]}" -gt 0 ]; then
        for declared_file in "${files[@]}"; do
          if [ "$dirty_path" = "$declared_file" ]; then
            declared_hit=true
            break
          fi
        done
      fi
      $declared_hit && continue
      filtered="${filtered:+${filtered}$'\n'}${dirty_line}"
    done <<< "$dirty"
    dirty="$filtered"
  fi
  if [ -n "$dirty" ]; then
    printf 'error: undeclared file(s) present -- pass them to --files or remove them:\n%s\n' "$dirty" >&2
    return 2
  fi

  # Commit pathspec: exactly what this invocation staged above — --files,
  # the derived feature dir, and --moved-from when present. A bare 'git
  # commit' would sweep in anything already staged by someone else before
  # this command ran; scoping to this pathspec commits only these paths and
  # leaves the rest of the index staged, untouched (7th defect).
  # Built incrementally, never via a bare "${files[@]}" expansion: bash 3.2
  # (macOS's /usr/bin/env bash) throws "unbound variable" expanding an empty
  # array under 'set -u' -- the same reason the 'git add' call above guards
  # it with a length check instead of expanding it directly.
  local -a commit_paths=()
  if [ "${#files[@]}" -gt 0 ]; then
    commit_paths+=("${files[@]}")
  fi
  commit_paths+=("$feature_dir")
  if [ -n "$moved_from" ]; then
    commit_paths+=("$moved_from")
  fi

  if git diff --cached --quiet -- "${commit_paths[@]}"; then
    printf 'error: nothing staged for commit\n' >&2
    return 5
  fi

  local subject
  if [ -n "$task" ]; then
    subject="${type}(${feature_id}): ${task} ${title}"
  else
    subject="${type}(${feature_id}): ${title}"
  fi

  if ! git commit -q -m "$subject" -- "${commit_paths[@]}"; then
    return 4
  fi

  local sha
  sha="$(git rev-parse HEAD)"
  printf '%s\n' "$sha"

  return 0
}

# ─── state-write ─────────────────────────────────────────────────────

# Digest of the working tree (tracked + untracked, respecting .gitignore)
# via a scratch index -- never the real one, never the real worktree. Both
# cmd_state_write (the writer) and detect_feature_phase (the reader) call
# this same helper, so freshness can never desync over the two computing
# "the tree changed" two different ways.
#
# EXCLUDES specs/** (post-T012 fix -- deadlock found by dogfooding this very
# feature). The digest exists to catch an uncommitted CODE edit after
# simplify/review sealed their receipt (AC6). specs/** is the pipeline's own
# bookkeeping, not code -- and /simplify-code and /review-feature both write
# to decisions.md in the SAME run that seals .sdd-state. Digesting specs/**
# meant the phase that seals the receipt also invalidates its own seal:
# simplify writes .sdd-state, appends its run notes to decisions.md, and the
# very next `sdd status` reports the sentinel stale with HEAD unchanged --
# `/simplify-code` would then re-run forever. Accepted trade-off (user
# decision): an uncommitted edit to spec.md no longer invalidates the
# receipt -- review reads the spec directly anyway.
#
# REJECTED, do not reopen (measured empirically for 025):
#   - `git stash create`: a different SHA on every call for the SAME dirty
#     tree -- the stash object is a commit and embeds a timestamp.
#   - `git write-tree` on the real index (no GIT_INDEX_FILE): silently
#     returns the tree from the last real `git add`, not what is on disk now.
#
# mktemp's file must be removed BEFORE first use: git treats an existing-
# but-empty path as a corrupt index ("index file smaller than expected") and
# refuses it outright, rather than treating it as "start fresh here" --
# confirmed empirically. Removed again after, on every path, since it is
# scratch state that must never survive the call.
#
# Prints the tree SHA on stdout; prints nothing on failure (caller decides
# how to treat an empty digest).
tree_digest() {
  local tmp
  tmp="$(mktemp)"
  rm -f "$tmp"

  local digest=""
  if GIT_INDEX_FILE="$tmp" git add -A -- ':(exclude)specs' >/dev/null 2>&1; then
    digest="$(GIT_INDEX_FILE="$tmp" git write-tree 2>/dev/null || true)"
  fi

  rm -f "$tmp"
  printf '%s\n' "$digest"
}

# Writes specs/<feature-id>/.sdd-state -- the single durable receipt that
# replaces .simplified. Exactly five fields, no `files:` list (025 decision:
# nothing reads it, and the files a phase touched already live in its own
# commit -- a source that can't lie). Called by /simplify-code (phase
# ready-to-review) and, from T006 on, /review-feature (phase reviewed).
cmd_state_write() {
  local usage_msg='usage: sdd state-write <feature-id> --phase <ready-to-review|reviewed> [--verdict <PASS|PASS-WITH-WARNINGS|FAIL|none>]'

  local feature_id="${1:-}"
  [ $# -gt 0 ] && shift

  if [ -z "$feature_id" ]; then
    printf 'error: %s\n' "$usage_msg" >&2
    return 2
  fi

  # Same rejection as commit-slice (AC2's validator, reused here rather than
  # re-implemented) -- checked before any git command runs.
  if ! validate_feature_id "$feature_id"; then
    printf 'error: invalid feature-id: "%s" (must not be empty, contain "..", contain "/", or start with "-")\n' "$feature_id" >&2
    return 2
  fi

  local phase="" verdict="none"

  while [ $# -gt 0 ]; do
    case "$1" in
      --phase)
        [ $# -ge 2 ] || { printf 'error: --phase requires a value\n' >&2; return 2; }
        phase="$2"
        shift 2
        ;;
      --verdict)
        [ $# -ge 2 ] || { printf 'error: --verdict requires a value\n' >&2; return 2; }
        verdict="$2"
        shift 2
        ;;
      *)
        printf 'error: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  case "$phase" in
    ready-to-review|reviewed) ;;
    *)
      printf 'error: --phase must be "ready-to-review" or "reviewed", got: "%s"\n' "$phase" >&2
      return 2
      ;;
  esac

  case "$verdict" in
    PASS|PASS-WITH-WARNINGS|FAIL|none) ;;
    *)
      printf 'error: --verdict must be one of PASS, PASS-WITH-WARNINGS, FAIL, none; got: "%s"\n' "$verdict" >&2
      return 2
      ;;
  esac

  local specs_dir feature_dir
  specs_dir="$(pwd)/specs"
  if ! feature_dir="$(resolve_feature_dir "$feature_id" "$specs_dir")"; then
    printf 'error: feature not found: %s\n' "$feature_id" >&2
    return 3
  fi

  local head
  head="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$head" ]; then
    printf 'error: no commits on the current branch -- cannot resolve HEAD\n' >&2
    return 4
  fi

  local digest
  digest="$(tree_digest)"
  if [ -z "$digest" ]; then
    printf 'error: could not compute tree digest\n' >&2
    return 4
  fi

  local at
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  {
    printf 'phase: %s\n' "$phase"
    printf 'git-head: %s\n' "$head"
    printf 'tree-digest: %s\n' "$digest"
    printf 'verdict: %s\n' "$verdict"
    printf 'at: %s\n' "$at"
  } > "$feature_dir/.sdd-state"

  return 0
}

# ─── verify-archive ──────────────────────────────────────────────────

# Verifies the CURRENT HEAD commit actually moved both halves of an archive:
# deletions under specs/<feature-id>/ AND additions under the matching
# specs/archive/*-<feature-id>/ dir, with specs/<feature-id>/ gone from HEAD's
# tree afterwards. Exists because prose alone never stopped it -- 021 and
# 294ccfc both landed an "archive" commit that was 6 additions, 0 deletions:
# a plain copy, not a move, with the old dir left fully tracked. Nothing read
# the commit after it landed to catch that. `--no-renames` is load-bearing:
# without it, a same-content delete+add collapses into a single R-line under
# git's default rename detection, which would hide the very halves this
# checks for (the reason the user asked for the flag in the first place).
#
# HEAD only, deliberately no --commit flag -- orchestrators run this
# immediately post-phase; a later check for stray duplicate archive dirs is
# `sdd status`'s job, not this command's (AC5/T003).
#
# Multi-date ambiguity (the same feature-id archived under two dates):
# resolved locally here via a sorted glob, guard-before-expand, never
# resolve_feature_dir -- that helper's first-match `find | head -1` stays
# untouched; other callers depend on its current behavior. Directory names
# are YYYY-MM-DD-prefixed, so lexicographic order is chronological order:
# the max is the most recent. A stderr note names the choice so a stale
# leftover dir is never silently favored.
#
# Shared by cmd_verify_archive and check_archive_integrity, which both need
# the same resolution rule.
# Args: feature_id, specs_dir
# Sets (globals): ARCHIVE_DIR_MATCHES (array, all specs/archive/*-<feature_id>
#                 matches, glob order), ARCHIVE_DIR_CHOSEN (the most recent
#                 match, or "" if none)
resolve_archive_dir() {
  local feature_id="$1" specs_dir="$2"

  ARCHIVE_DIR_MATCHES=()
  ARCHIVE_DIR_CHOSEN=""

  local candidate
  for candidate in "$specs_dir"/archive/*-"$feature_id"; do
    [ -d "$candidate" ] && ARCHIVE_DIR_MATCHES+=("$candidate")
  done

  [ "${#ARCHIVE_DIR_MATCHES[@]}" -eq 0 ] && return 0

  if [ "${#ARCHIVE_DIR_MATCHES[@]}" -gt 1 ]; then
    ARCHIVE_DIR_CHOSEN="$(printf '%s\n' "${ARCHIVE_DIR_MATCHES[@]}" | sort | tail -1)"
  else
    ARCHIVE_DIR_CHOSEN="${ARCHIVE_DIR_MATCHES[0]}"
  fi
}

cmd_verify_archive() {
  local usage_msg='usage: sdd verify-archive <feature-id>'

  local feature_id="${1:-}"
  [ $# -gt 0 ] && shift

  if [ -z "$feature_id" ]; then
    printf 'error: %s\n' "$usage_msg" >&2
    return 2
  fi

  if ! validate_feature_id "$feature_id"; then
    printf 'error: invalid feature-id: "%s" (must not be empty, contain "..", contain "/", or start with "-")\n' "$feature_id" >&2
    return 2
  fi

  if [ $# -gt 0 ]; then
    printf 'error: unknown option: %s\n' "$1" >&2
    return 2
  fi

  local specs_dir
  specs_dir="$(pwd)/specs"

  resolve_archive_dir "$feature_id" "$specs_dir"

  if [ "${#ARCHIVE_DIR_MATCHES[@]}" -eq 0 ]; then
    printf 'error: no archive directory found for %s under specs/archive/\n' "$feature_id" >&2
    return 3
  fi

  local archive_dir="$ARCHIVE_DIR_CHOSEN"
  if [ "${#ARCHIVE_DIR_MATCHES[@]}" -gt 1 ]; then
    printf 'note: multiple archive directories found for %s; using the most recent: %s\n' \
      "$feature_id" "$(basename "$archive_dir")" >&2
  fi

  local archive_rel
  archive_rel="specs/archive/$(basename "$archive_dir")"

  local head
  head="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$head" ]; then
    printf 'error: no commits on the current branch -- cannot resolve HEAD\n' >&2
    return 3
  fi

  local name_status
  name_status="$(git show --no-renames --name-status --format= "$head" 2>/dev/null || true)"

  local deleted_count=0 added_count=0
  local deleted_prefix="specs/${feature_id}/"
  local change_type change_path
  while IFS=$'\t' read -r change_type change_path; do
    [ -n "$change_type" ] || continue
    case "$change_type" in
      D)
        case "$change_path" in
          "$deleted_prefix"*) deleted_count=$((deleted_count + 1)) ;;
        esac
        ;;
      A)
        case "$change_path" in
          "$archive_rel/"*) added_count=$((added_count + 1)) ;;
        esac
        ;;
    esac
  done <<EOF
$name_status
EOF

  # Nothing added under the archive dir: HEAD is not an archive commit for
  # this feature at all (e.g. run long after the fact, on an unrelated
  # commit) -- unresolvable, not a verification failure. This is also what
  # keeps documented-cli-usage's fixture (specs/<id>/ present, no archive at
  # all) at exit 3 rather than 1 or 2.
  if [ "$added_count" -eq 0 ]; then
    printf 'error: HEAD (%s) adds nothing under %s -- nothing to verify\n' "$head" "$archive_rel" >&2
    return 3
  fi

  local still_tracked
  still_tracked="$(git ls-tree -r --name-only HEAD -- "specs/${feature_id}" 2>/dev/null || true)"

  if [ "$deleted_count" -eq 0 ] || [ -n "$still_tracked" ]; then
    printf 'error: archive commit %s is missing the deletions under specs/%s/ (found %s addition(s) under %s, %s deletion(s) under specs/%s/)\n' \
      "$head" "$feature_id" "$added_count" "$archive_rel" "$deleted_count" "$feature_id" >&2
    return 1
  fi

  printf 'ok: %s archived cleanly in %s (%s deletion(s), %s addition(s) under %s)\n' \
    "$feature_id" "$head" "$deleted_count" "$added_count" "$archive_rel"
  return 0
}

# ─── status ────────────────────────────────────────────────────────

# T003/AC5: detects specs/<feature_id>/ and specs/archive/*-<feature_id>/
# present at once -- the shape a bypassed archive run leaves behind (021,
# 294ccfc). Runs independent of resolve_feature_dir: that helper's
# first-match `find | head -1` picks specs/<feature_id>/ and stops, so a
# caller relying on it alone never learns the archive half exists too. This
# re-probes the filesystem itself so it can't inherit that blind spot.
# resolve_feature_dir stays untouched -- its other callers depend on the
# current first-match behavior.
#
# Args: feature_id, specs_dir
# Sets (globals): ARCHIVE_INTEGRITY_BROKEN ("true"/"false", usable directly
#                 in `if`), ARCHIVE_MATCH_RESULT ("specs/archive/<dir>" when
#                 broken, else "")
check_archive_integrity() {
  local feature_id="$1" specs_dir="$2"

  ARCHIVE_INTEGRITY_BROKEN=false
  ARCHIVE_MATCH_RESULT=""

  [ -d "$specs_dir/$feature_id" ] || return 0

  resolve_archive_dir "$feature_id" "$specs_dir"
  [ -z "$ARCHIVE_DIR_CHOSEN" ] && return 0

  ARCHIVE_INTEGRITY_BROKEN=true
  ARCHIVE_MATCH_RESULT="specs/archive/$(basename "$ARCHIVE_DIR_CHOSEN")"
}

# Computes phase, task counts, sentinel freshness, and the next command for
# one resolved feature directory. Extracted from cmd_status so both the
# single-feature JSON and the no-arg listing (T003/F12) derive phase the same
# way — the single-feature JSON output is unchanged by this extraction.
#
# Args: feature_id, feature_dir, is_archived ("true"/"false")
# Sets (globals): PHASE_RESULT, TASKS_TOTAL_RESULT, TASKS_REMAINING_RESULT,
#                 SENTINEL_FRESH_RESULT ("true"/"false"), NEXT_COMMAND_RESULT
detect_feature_phase() {
  local feature_id="$1" feature_dir="$2" is_archived="$3"

  # ── Phase detection ─────────────────────────────────────────────
  local phase

  if $is_archived; then
    phase="archived"
  elif [ ! -f "$feature_dir/spec.md" ] && [ ! -f "$feature_dir/quick-spec.md" ]; then
    phase="missing"
  elif [ ! -f "$feature_dir/plan.md" ] || [ ! -f "$feature_dir/tasks.md" ]; then
    # Check if fast-lane (quick-spec.md present without plan.md/tasks.md is OK)
    if [ -f "$feature_dir/quick-spec.md" ]; then
      # Fast-lane: use quick-spec.md for tasks — fall through to task counting below
      phase=""  # determined after task counting
    else
      phase="spec"
    fi
  else
    phase=""  # determined after task counting
  fi

  # ── Task counting ────────────────────────────────────────────────
  local tasks_done=0
  local tasks_remaining=0
  local tasks_total=0

  if [ -z "$phase" ] || [ "$phase" = "" ]; then
    # Determine task file
    local task_file=""
    if [ -f "$feature_dir/tasks.md" ]; then
      task_file="$feature_dir/tasks.md"
      tasks_done=$(grep -c '^\- \[x\]' "$task_file" 2>/dev/null || true)
      tasks_remaining=$(grep -c '^\- \[ \]' "$task_file" 2>/dev/null || true)
    elif [ -f "$feature_dir/quick-spec.md" ]; then
      # Fast-lane: grep only inside the ## Tasks section
      # Extract from '## Tasks' to next '##' or end of file
      local in_tasks=false
      while IFS= read -r line; do
        if [[ "$line" =~ ^##[[:space:]]Tasks ]]; then
          in_tasks=true
          continue
        fi
        if $in_tasks && [[ "$line" =~ ^## ]]; then
          break
        fi
        if $in_tasks; then
          if [[ "$line" =~ ^\-[[:space:]]\[x\] ]]; then
            ((tasks_done++)) || true
          elif [[ "$line" =~ ^\-[[:space:]]\[[[:space:]]\] ]]; then
            ((tasks_remaining++)) || true
          fi
        fi
      done < "$feature_dir/quick-spec.md"
    fi
    tasks_total=$((tasks_done + tasks_remaining))

    # ── Sentinel freshness ──────────────────────────────────────────
    # V6: freshness must be tied to BOTH the commit (git-head) AND the
    # working tree (tree-digest) -- an uncommitted edit to a tracked file
    # changes tree-digest without touching git-head, and AC6 requires that
    # to invalidate the sentinel. The old .simplified behaviour checked
    # git-head alone and missed exactly that. tree_digest() is the same
    # helper cmd_state_write uses to compute the value stored here, so
    # writer and reader can never drift into two different notions of "the
    # tree changed".
    local sentinel_fresh=false
    local sentinel_file="$feature_dir/.sdd-state"
    local state_phase=""
    local state_verdict=""
    if [ -f "$sentinel_file" ]; then
      local current_head state_head state_digest
      current_head="$(git rev-parse HEAD 2>/dev/null || true)"
      state_head="$(grep -m1 '^git-head: ' "$sentinel_file" 2>/dev/null | sed 's/^git-head: //')"
      if [ -n "$current_head" ] && [ "$current_head" = "$state_head" ]; then
        state_digest="$(grep -m1 '^tree-digest: ' "$sentinel_file" 2>/dev/null | sed 's/^tree-digest: //')"
        local current_digest
        current_digest="$(tree_digest)"
        if [ -n "$current_digest" ] && [ "$current_digest" = "$state_digest" ]; then
          sentinel_fresh=true
          # T006: .sdd-state's own `phase:` field disambiguates WHICH fresh
          # phase this is -- /simplify-code writes ready-to-review,
          # /review-feature writes reviewed (on PASS/PASS-WITH-WARNINGS, or
          # on a judge block -- see review-feature/SKILL.md Step 4/6.5). A
          # reviewer conformance FAIL clears the sentinel entirely instead of
          # writing "reviewed" here (review-feature Step 5), so this branch
          # never has to tell that case apart from a plain stale sentinel.
          state_phase="$(grep -m1 '^phase: ' "$sentinel_file" 2>/dev/null | sed 's/^phase: //')"
          # T007: read alongside phase, not computed separately, so the two
          # can never be read from two different sentinel snapshots. Only
          # meaningful when state_phase="reviewed" (below) -- a judge block
          # writes "reviewed" with verdict FAIL, and the next-command
          # mapping needs to tell that apart from a passing review so it
          # never points a human at a command sdd-archive-feature.md's own
          # gate (T007) will refuse.
          state_verdict="$(grep -m1 '^verdict: ' "$sentinel_file" 2>/dev/null | sed 's/^verdict: //')"
        fi
      fi
    fi

    # Now determine phase based on task counts + sentinel
    if [ "$tasks_total" -eq 0 ]; then
      # No tasks found — treat as planned (empty tasks file)
      phase="planned"
    elif [ "$tasks_remaining" -eq "$tasks_total" ]; then
      phase="planned"
    elif [ "$tasks_remaining" -gt 0 ]; then
      phase="implementing"
    elif $sentinel_fresh; then
      # Any value other than the literal "reviewed" (missing, corrupt,
      # unrecognised) falls back to ready-to-review rather than trusting it.
      case "$state_phase" in
        reviewed) phase="reviewed" ;;
        *)        phase="ready-to-review" ;;
      esac
    else
      phase="ready-to-simplify"
    fi
  else
    # Phase already determined (archived, missing, spec); set sentinel and counts
    local sentinel_fresh=false
    tasks_total=0
    tasks_remaining=0
  fi

  # ── Next command ────────────────────────────────────────────────
  local next_command
  case "$phase" in
    missing)           next_command="/sdd-new" ;;
    spec)              next_command="/plan-feature ${feature_id}" ;;
    planned)           next_command="/implement-task ${feature_id}" ;;
    implementing)      next_command="/implement-task ${feature_id}" ;;
    ready-to-simplify) next_command="/simplify-code ${feature_id}" ;;
    ready-to-review)   next_command="/review-feature ${feature_id}" ;;
    reviewed)
      # T007: verdict-aware. A judge block (`state-write --phase reviewed
      # --verdict FAIL`) sets phase to "reviewed" the same as a passing
      # review does (T006), but sdd-archive-feature.md's own pre-flight gate
      # (T007/AC11) refuses to archive it. Pointing a human at
      # /archive-feature here would be exactly the class of bug 025 exists
      # to remove: a status oracle asserting something the pipeline's own
      # gate then contradicts. See decisions.md for the rejected
      # unconditional alternative.
      case "$state_verdict" in
        PASS|PASS-WITH-WARNINGS) next_command="/archive-feature ${feature_id}" ;;
        *) next_command="(blocked — review verdict is ${state_verdict:-none}; a human decision is needed, see decisions.md)" ;;
      esac
      ;;
    archived)          next_command="(none — feature archived)" ;;
    *)                 next_command="(unknown)" ;;
  esac

  # Normalise sentinel_fresh to a JSON boolean string
  local sentinel_json="false"
  if ${sentinel_fresh:-false}; then
    sentinel_json="true"
  fi

  PHASE_RESULT="$phase"
  TASKS_TOTAL_RESULT="$tasks_total"
  TASKS_REMAINING_RESULT="$tasks_remaining"
  SENTINEL_FRESH_RESULT="$sentinel_json"
  NEXT_COMMAND_RESULT="$next_command"
}

# No-arg status: lists every active spec (specs/*/ minus specs/archive/) as a
# JSON array of {feature_id, phase, next_command}. Archived folders are
# excluded on purpose (F12) — a finished-but-unarchived feature left sitting
# in specs/ is false context the model reads as active work, and that's
# exactly what this listing surfaces; burying it among already-archived
# folders would defeat the point.
cmd_status_list() {
  local specs_dir
  specs_dir="$(pwd)/specs"

  local items="" first=true
  local dir feature_id

  if [ -d "$specs_dir" ]; then
    for dir in "$specs_dir"/*/; do
      [ -d "$dir" ] || continue
      feature_id="$(basename "$dir")"
      [ "$feature_id" = "archive" ] && continue

      check_archive_integrity "$feature_id" "$specs_dir"
      if $ARCHIVE_INTEGRITY_BROKEN; then
        PHASE_RESULT="archive-integrity-broken"
        NEXT_COMMAND_RESULT="(blocked -- specs/${feature_id}/ and ${ARCHIVE_MATCH_RESULT}/ are both tracked; resolve manually before continuing)"
      else
        detect_feature_phase "$feature_id" "${dir%/}" false
      fi

      local entry
      entry="$(printf '{"feature_id": "%s", "phase": "%s", "next_command": "%s"}' \
        "$feature_id" "$PHASE_RESULT" "$NEXT_COMMAND_RESULT")"

      if $first; then
        items="  $entry"
        first=false
      else
        items="$items,
  $entry"
      fi
    done
  fi

  if [ -z "$items" ]; then
    printf '[]\n'
  else
    printf '[\n%s\n]\n' "$items"
  fi
  exit 0
}

cmd_status() {
  local feature_id="${1:-}"

  # ── Feature-id resolution ────────────────────────────────────────
  # An omitted feature-id ALWAYS lists (AC8) — no branch-name sniffing. AC8
  # names no condition about the current branch, and a developer running the
  # bare command is almost always on a feature branch, which is exactly when
  # the listing is most useful. Explicit `sdd status <id>` is unaffected.
  if [ -z "$feature_id" ]; then
    cmd_status_list
    return
  fi

  # ── Folder lookup ────────────────────────────────────────────────
  local specs_dir
  specs_dir="$(pwd)/specs"

  local feature_dir=""
  local is_archived=false

  if feature_dir="$(resolve_feature_dir "$feature_id" "$specs_dir")"; then
    [ "$feature_dir" = "$specs_dir/$feature_id" ] || is_archived=true
  fi

  if [ -z "$feature_dir" ]; then
    printf 'error: feature not found: %s\n' "$feature_id" >&2
    exit 1
  fi

  # ── Blockers array ──────────────────────────────────────────────
  local blockers='[]'

  check_archive_integrity "$feature_id" "$specs_dir"
  if $ARCHIVE_INTEGRITY_BROKEN; then
    PHASE_RESULT="archive-integrity-broken"
    TASKS_TOTAL_RESULT=0
    TASKS_REMAINING_RESULT=0
    SENTINEL_FRESH_RESULT="false"
    NEXT_COMMAND_RESULT="(blocked -- specs/${feature_id}/ and ${ARCHIVE_MATCH_RESULT}/ are both tracked; resolve manually before continuing)"
    blockers="$(printf '[{"type": "archive-integrity-broken", "message": "specs/%s/ and %s/ are both tracked"}]' \
      "$feature_id" "$ARCHIVE_MATCH_RESULT")"
  else
    detect_feature_phase "$feature_id" "$feature_dir" "$is_archived"
  fi

  # ── JSON emission ────────────────────────────────────────────────
  printf '{\n'
  printf '  "feature_id": "%s",\n' "$feature_id"
  printf '  "phase": "%s",\n' "$PHASE_RESULT"
  printf '  "tasks_total": %d,\n' "$TASKS_TOTAL_RESULT"
  printf '  "tasks_remaining": %d,\n' "$TASKS_REMAINING_RESULT"
  printf '  "sentinel_fresh": %s,\n' "$SENTINEL_FRESH_RESULT"
  printf '  "blockers": %s,\n' "$blockers"
  printf '  "next_command": "%s"\n' "$NEXT_COMMAND_RESULT"
  printf '}\n'
  exit 0
}

# ─── domain-vocab ───────────────────────────────────────────────────

# Prints .claude/rules/domains.md whole so the four consumers that used to
# grep the file directly can call the CLI instead (ADR 0003: the CLI
# resolves content, the agent reads knobs directly). No heading to find and
# no section to extract: the domain vocabulary owns its whole file now, so
# this reads it byte-for-byte and goes straight to the emptiness check
# below.
#
# A comment-only file counts as empty — domains.md ships with exactly that
# shape ("<!-- Project-specific business logic rules -->", 46 chars) until
# a project fills it in — so blank and comment-only lines are filtered out
# here before deciding emptiness. "Empty" and "absent" collapse to the same
# exit code: the spec treats them as one branch and no consumer
# distinguishes them.
cmd_domain_vocab() {
  local file=".claude/rules/domains.md"

  [ -f "$file" ] || return 3

  local section
  section="$(cat "$file")"

  # Strip whole '<!-- ... -->' spans before testing for emptiness, however
  # many lines they cover. A filter that only matched a comment opening and
  # closing on the SAME line let a two-line HTML comment survive as printed
  # "vocabulary" — contradicting the spec's "comment-only counts as empty".
  # awk gsub has no non-greedy quantifier, so a char-class trick
  # ('[^-]*(-[^-]+)*') was used to fake a shortest match between '<!--' and
  # '-->'. That trick breaks under POSIX ERE's leftmost-longest semantics
  # the moment the comment BODY itself contains '--' (an em-dash, common in
  # this repo's own prose): it leaves the comment unstripped, so it prints
  # as if it were real vocabulary instead of counting as empty (review fix
  # cycle 3, judge finding). index()/substr() sidesteps greediness
  # entirely: find the next '<!--', find the next '-->' after it, cut that
  # span, repeat — no regex, so no shortest-vs-longest ambiguity to get
  # wrong. An unterminated '<!--' (no matching '-->' left in buf) stops the
  # loop and leaves the remainder untouched, so a dangling comment marker
  # still counts as real content, not as empty.
  local stripped
  stripped="$(printf '%s\n' "$section" | awk '
    { buf = buf $0 "\n" }
    END {
      while ((s = index(buf, "<!--")) > 0) {
        rest = substr(buf, s + 4)
        e = index(rest, "-->")
        if (e == 0) break
        buf = substr(buf, 1, s - 1) substr(rest, e + 3)
      }
      printf "%s", buf
    }
  ')"

  local filtered
  filtered="$(printf '%s\n' "$stripped" | grep -vE '^[[:space:]]*$' || true)"

  if [ -z "$filtered" ]; then
    return 3
  fi

  printf '%s\n' "$section"
  return 0
}

# ─── main ──────────────────────────────────────────────────────────

case "${1:-help}" in
  init)         shift; cmd_init "$@" ;;
  update)       cmd_update ;;
  doctor)       cmd_doctor ;;
  base-branch)  shift; cmd_base_branch "$@" ;;
  branch)       shift; cmd_branch "$@" ;;
  commit-slice) shift; cmd_commit_slice "$@" ;;
  status)       shift; cmd_status "$@" ;;
  state-write)  shift; cmd_state_write "$@" ;;
  verify-archive) shift; cmd_verify_archive "$@" ;;
  domain-vocab) cmd_domain_vocab ;;
  help|--help|-h) usage ;;
  version|--version|-v) echo "sdd v${VERSION}" ;;
  *)
    err "Unknown command: $1"
    usage
    exit 1
    ;;
esac
